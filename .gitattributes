# 统一换行符策略：
#   - 仓库内（存储）统一为 LF
#   - Windows 检出时 git 自动转换为 CRLF（autocrlf）
# 这样避免 CRLF/LF 混合造成的大量「全行变更」diff 噪音。

* text=auto

# 显式声明为文本文件（LF 存储）
*.md     text eol=lf
*.ts     text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
*.mjs    text eol=lf

# 二进制文件（不做换行符转换）
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
